# CLIPMIND AI Environment Configuration

PROJECT_NAME="CLIPMIND AI"
VERSION="1.0.0"

# Security
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default is local SQLite with async driver:
DATABASE_URL="sqlite+aiosqlite:///storage/clipmind.db"
# Or PostgreSQL for distributed production scale:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/clipmind"

# Video Processing Limits
MAX_UPLOAD_SIZE_BYTES=2147483648

# Optional AI Acceleration Keys
OPENAI_API_KEY=""
GROQ_API_KEY=""
